class Solution {

    public String dayOfTheWeek(int day, int month, int year) {

        String[] week = {
            "Sunday",
            "Monday",
            "Tuesday",
            "Wednesday",
            "Thursday",
            "Friday",
            "Saturday"
        };

        int totalDays = 0;

       
        for (int i = 1971; i < year; i++) {
            if (isLeapYear(i)) {
                totalDays += 366;
            } else {
                totalDays += 365;
            }
        }

      
        int[] daysInMonth = {
            31, 28, 31, 30, 31, 30,
            31, 31, 30, 31, 30, 31
        };

        for (int i = 1; i < month; i++) {
            totalDays += daysInMonth[i - 1];
        }

       
        if (month > 2 && isLeapYear(year)) {
            totalDays++;
        }

        
        totalDays += day - 1;

      
        int dayIndex = (5 + totalDays) % 7;

        return week[dayIndex];
    }

    public boolean isLeapYear(int year) {

        if (year % 400 == 0) {
            return true;
        }

        if (year % 100 == 0) {
            return false;
        }

        if (year % 4 == 0) {
            return true;
        }

        return false;
    }
}


