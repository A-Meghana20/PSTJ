class Solution {

    public int daysBetweenDates(String date1, String date2) {

        int year1 = Integer.parseInt(date1.substring(0, 4));
        int month1 = Integer.parseInt(date1.substring(5, 7));
        int day1 = Integer.parseInt(date1.substring(8, 10));

        int year2 = Integer.parseInt(date2.substring(0, 4));
        int month2 = Integer.parseInt(date2.substring(5, 7));
        int day2 = Integer.parseInt(date2.substring(8, 10));

        int days1 = totalDays(year1, month1, day1);
        int days2 = totalDays(year2, month2, day2);

        return Math.abs(days1 - days2);
    }

    public int totalDays(int year, int month, int day) {

        int total = 0;

        // Add days of previous years
        for (int i = 1; i < year; i++) {
            if (isLeapYear(i)) {
                total += 366;
            } else {
                total += 365;
            }
        }

        // Days in each month
        int[] daysInMonth = {
            31, 28, 31, 30, 31, 30,
            31, 31, 30, 31, 30, 31
        };

        // Add days of previous months
        for (int i = 1; i < month; i++) {
            total += daysInMonth[i - 1];
        }

        // Add one extra day for leap year in February
        if (month > 2 && isLeapYear(year)) {
            total++;
        }

        // Add current day
        total += day;

        return total;
    }

    public boolean isLeapYear(int year) {

        if (year % 400 == 0) {
            return true;
        }

        if (year % 100 == 0) {
            return false;
        }

        if (year % 4 == 0) {
            return true;
        }

        return false;
    }
}




