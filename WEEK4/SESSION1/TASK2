import java.util.*;

class Main {
    public static void main(String[] args) {
        Scanner sc = new Scanner(System.in);

        int T = sc.nextInt();

        while (T-- > 0) {
            String s = sc.next();

            int n = s.length();
            int[] count = new int[26];

            // Count characters in the left half
            for (int i = 0; i < n / 2; i++) {
                count[s.charAt(i) - 'a']++;
            }

            // Count characters in the right half
            for (int i = (n + 1) / 2; i < n; i++) {
                count[s.charAt(i) - 'a']--;
            }

            boolean lapindrome = true;

            // Check whether all frequencies are equal
            for (int i = 0; i < 26; i++) {
                if (count[i] != 0) {
                    lapindrome = false;
                    break;
                }
            }

            System.out.println(lapindrome ? "YES" : "NO");
        }

        sc.close();
    }
}


